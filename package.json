{
  "name": "yasu224",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt --write .",
    "tsc": "tsgo --noEmit",
    "pre-commit-check": "npm run lint && npm run format && npm run tsc && npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook",
    "test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"magenta,blue\" \"npx http-server storybook-static --port 6006 --silent\" \"wait-on tcp:127.0.0.1:6006 && test-storybook\"",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "prisma": "^7.10.1",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "stripe": "^23.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@storybook/test-runner": "^0.26.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "^7.0.0-dev.20260320.1",
    "concurrently": "^10.0.6",
    "dotenv": "^17.4.0",
    "http-server": "^14.1.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "postcss": "^8",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wait-on": "^9.5.1"
  },
  "overrides": {
    "playwright": "^1.60.0",
    "playwright-core": "^1.60.0",
    "uuid": "^11.1.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.13.0"
}
